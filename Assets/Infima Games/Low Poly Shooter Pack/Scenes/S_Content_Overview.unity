      objectReference: {fileID: 0}
    - target: {fileID: 4817883505248712873, guid: cdd74a287d6763748a0da1e717364366,
        type: 3}
      propertyPath: m_text
      value: "In order to keep animations consistent and speed up workflow we have
        opted to use a few \"common/shared\" animations between all weapon sets.\n\nThis
        is especially useful for animations that work well across many different
        weapons, such as the walking, running, and idle animations.\n\nThis means
        that we only need one animation file for each common animation, speeding
        up our workflow as well as keeping the project less cluttered.\n\nAdditive
        Set-Up:\n\nThese animations are played additively on the gun bone in the
        skeleton, which means that they can play on top of the custom poses made
        for each weapon. \n\nThis way each weapon can have custom finger/hand posing,
        and also play the common animations on top."
      objectReference: {fileID: 0}
    - target: {fileID: 4817883505248712873, guid: cdd74a287d6763748a0da1e717364366,
        type: 3}
      propertyPath: m_fontSize
      value: 0.15
      objectReference: {fileID: 0}
    - target: {fileID: 4817883505248712873, guid: cdd74a287d6763748a0da1e717364366,
        type: 3}
      propertyPath: m_fontStyle
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4817883505248712873, guid: cdd74a287d6763748a0da1e717364366,
        type: 3}
      propertyPath: m_fontSizeBase
      value: 0.15
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: cdd74a287d6763748a0da1e717364366, type: 3}
